# Dev overlay: deploy the ui module's oidc-capsule example (the single source of truth for
# the Headlamp resources) adapted for the local dev cluster —
#   - image swapped to the Tilt-built image (localhost:5000/headlamp-sd:dev)
#   - ingress host injected via patch-ingress-host.yaml (generated by generate-templates.sh
#     from the .tpl; sets headlamp.<NIP_DOMAIN>)
#
# The base is injected by generate-templates.sh from $SD_UI_CAPSULE_BASE, which defaults to
# a remote kustomize reference to sighupio/module-utilities pinned to $SD_UI_MODULE_REF
# (set SD_UI_MODULE_PATH to use a local checkout instead).
# Consumed by the Tiltfile via kustomize().
---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ${SD_UI_CAPSULE_BASE}

images:
  - name: registry.sighup.io/fury/sd-ui
    newName: localhost:5000/headlamp-sd
    newTag: dev

patches:
  - path: patch-ingress-host.yaml
