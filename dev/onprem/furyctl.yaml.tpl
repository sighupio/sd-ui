# furyctl config TEMPLATE for the OnPremises dev environment (Lima VMs).
# Rendered by dev/onprem/scripts/render.sh (envsubst, explicit variable list) into
# dev/onprem/state/furyctl.yaml. Every `{file://...}` value and plugin folder is an absolute
# path: secrets and generated files under dev/onprem/state/ (gitignored, created by
# render.sh), committed manifests under dev/onprem/manifests/.
---
apiVersion: kfd.sighup.io/v1alpha2
kind: OnPremises
metadata:
  name: sd-ui-onprem
spec:
  distributionVersion: v1.36.0
  kubernetes:
    pkiFolder: ${ONPREM_PKI_DIR}
    ssh:
      username: ${ONPREM_SSH_USER}
      keyPath: ${ONPREM_SSH_KEY}
    # Node and load balancer names embed their IP (e.g. sdui-cp0-192-168-64-3), so
    # <name>.nip.io resolves without any DNS server.
    dnsZone: nip.io
    controlPlaneAddress: ${ONPREM_LB_NAME}.nip.io:6443
    podCidr: 10.244.0.0/16
    svcCidr: 10.96.0.0/12
    # HAProxy on the load balancer VM: 6443 -> API server (managed by furyctl), 80/443 ->
    # ingress NodePorts on the workers (additionalConfig, generated by render.sh).
    loadBalancers:
      enabled: true
      hosts:
        - name: ${ONPREM_LB_NAME}
          ip: ${ONPREM_LB_IP}
      # Single load balancer: no keepalived. The furyctl preflight/kubernetes templates read
      # every keepalived field even when it's disabled, so they're set but unused.
      keepalived:
        enabled: false
        interface: lima0
        ip: ${ONPREM_LB_IP}/32
        virtualRouterId: "201"
        passphrase: "unused00"
      stats:
        username: admin
        password: "{file://${ONPREM_STATE_DIR}/secrets/haproxy-stats-password.txt}"
      additionalConfig: "{file://${ONPREM_STATE_DIR}/haproxy-additional.cfg}"
    masters:
      hosts:
        - name: ${ONPREM_CP_NAME}
          ip: ${ONPREM_CP_IP}
    nodes:
      - name: worker
        hosts:
${ONPREM_WORKER_HOSTS}
        taints: []
    advanced:
      # kube-apiserver trusts the Dex tokens forwarded by Pomerium (audience `pomerium`, the
      # Dex client Pomerium uses). ca_file is installed on the nodes by the Lima template.
      # username_prefix "-" disables the prefix; groups always get the `oidc:` prefix.
      oidc:
        issuer_url: https://login.${ONPREM_DOMAIN}
        client_id: pomerium
        ca_file: /usr/local/share/ca-certificates/sd-ui-dev-ca.crt
        username_claim: email
        username_prefix: "-"
        groups_claim: groups
      # Local registry on the Mac, reached through Lima's host alias (plain HTTP).
      containerd:
        registryConfigs:
          - registry: host.lima.internal:${ONPREM_REGISTRY_PORT}
            mirrorEndpoint:
              - http://host.lima.internal:${ONPREM_REGISTRY_PORT}
            insecureSkipVerify: true
  distribution:
    common:
      networkPoliciesEnabled: false
    modules:
      networking:
        type: cilium
      ingress:
        baseDomain: ${ONPREM_DOMAIN}
        nginx:
          type: single
          tls:
            provider: certManager
        certManager:
          clusterIssuer:
            name: letsencrypt-fury
            email: dev@sighup.io
            type: http01
      logging:
        type: loki
        minio:
          storageSize: 20Gi
          rootUser:
            username: minio
            password: "{file://${ONPREM_STATE_DIR}/secrets/minio-password.txt}"
        loki:
          backend: minio
          tsdbStartDate: "2026-03-19"
      monitoring:
        type: prometheus
        prometheus:
          retentionTime: 3d
          retentionSize: 5GiB
          storageSize: 5Gi
      tracing:
        type: none
      policy:
        type: kyverno
        kyverno:
          additionalExcludedNamespaces: ["local-path-storage"]
          validationFailureAction: Audit
          installDefaultPolicies: true
      dr:
        type: on-premises
        velero: {}
      auth:
        provider:
          type: sso
        pomerium:
          secrets:
            COOKIE_SECRET: "{file://${ONPREM_STATE_DIR}/secrets/pomerium/cookie_secret.txt}"
            IDP_CLIENT_SECRET: "{file://${ONPREM_STATE_DIR}/secrets/pomerium/idp_client_secret.txt}"
            SHARED_SECRET: "{file://${ONPREM_STATE_DIR}/secrets/pomerium/shared_secret.txt}"
            SIGNING_KEY: "{file://${ONPREM_STATE_DIR}/secrets/pomerium/signing_key.txt}"
        baseDomain: ${ONPREM_DOMAIN}
        oidcTrustedCA: "{file://${ONPREM_STATE_DIR}/certs/ca.crt}"
        dex:
          connectors:
            - type: ldap
              id: ldap
              name: LDAP
              config:
                host: ldap-server.demo-ldap.svc:389
                insecureNoSSL: true
                bindDN: CN=admin,DC=sighup,DC=io
                bindPW: admin
                userSearch:
                  baseDN: ou=people,DC=sighup,DC=io
                  filter: "(objectClass=person)"
                  username: cn
                  idAttr: cn
                  emailAttr: mail
                  nameAttr: displayName
                groupSearch:
                  baseDN: DC=sighup,DC=io
                  filter: "(objectClass=groupOfNames)"
                  userMatchers:
                    - userAttr: DN
                      groupAttr: member
                  nameAttr: cn
      # Headlamp (SD-UI) deployed by the distribution. Members of the LDAP group get the
      # `oidc:` prefixed group bound to the sd-ui-reader role.
      utilities:
        headlamp:
          type: sso
          oidcGroup: ${SD_UI_GROUP}
    customPatches:
      # Dev build of the SD-UI image, pushed by `mise run onprem:image`.
      images:
        - name: registry.sighup.io/fury/sd-ui
          newName: ${SD_UI_IMAGE_REPO}
          newTag: ${SD_UI_IMAGE_TAG}
      # Every ingress certificate is signed by the environment's own CA.
      patches:
        - patch: |-
            - op: replace
              path: /metadata/annotations/cert-manager.io~1cluster-issuer
              value: sd-ui-dev-ca
          target:
            kind: Ingress
  plugins:
    kustomize:
      - name: dev-ca-issuer
        folder: ${ONPREM_DIR}/manifests/dev-ca-issuer
      - name: ldap-server
        folder: ${ONPREM_STATE_DIR}/plugins/ldap-server
