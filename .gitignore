# Furyctl
.furyctl/

# Dependencies
node_modules/

# Plugin packages (`headlamp-plugin package`)
*.tgz

# Host IP (user-specific, required for nip.io DNS)
host-ip.txt

# Kind dev environment: everything generated (CA, secrets, kubeconfig, rendered cluster
# config, tenant login artifacts) lives in dev/kind/state/. `mise run clean` deletes it.
dev/kind/state/
# Rendered next to their templates, because kustomize resolves files relative to the
# kustomization (dev/kind/scripts/generate-templates.sh).
dev/kind/plugins/kustomize/gangplank/gangplank.yml
dev/kind/plugins/kustomize/gangplank/ingress.yml
dev/kind/plugins/kustomize/gangplank/oidc-trusted-ca.yml
dev/kind/plugins/kustomize/capsule-proxy-ingress/ingress.yml
dev/kind/plugins/kustomize/ldap-server/users.ldif
dev/kind/tilt/*/kustomization.yaml
dev/kind/tilt/*/patch-ingress-host.yaml
# Registry mirror cache (persistent across cluster rebuilds).
dev/kind/registry-cache/data/
# Any kubeconfig dropped elsewhere in the tree (including the pre-dev/kind/state/ location
# at the repo root) holds cluster credentials.
kubeconfig
kubeconfig-*

# Build artifacts (desktop app, etc.)
.build/

# OnPremises dev environment state: VM IPs, SSH key, CA, PKI, secrets, rendered furyctl
# config, kubeconfig, furyctl work dirs. Everything here is generated.
dev/onprem/state/

# Plugin build artifacts and dev files. dist/ is built by the Dockerfile (CI) or by
# `npm run build` (local dev), never committed; package-lock.json IS committed (npm ci).
plugins/*/dist/
plugins/*/.eslintcache
# Boilerplate generated by the @kinvolk/headlamp-plugin scaffold (its template/
# dir), not written by us. The Tiltfile ignores them too, so they never trigger
# a rebuild.
plugins/*/AGENTS.md
plugins/*/README.md
